# Environment setup for all shells (interactive and non-interactive).

# Guard against double-sourcing
[[ -n "$_MMC_ZSHENV_LOADED" ]] && return
_MMC_ZSHENV_LOADED=1

export ZSH="${HOME}/.zsh"

# Source order matters: go.zsh sets GOPATH which path.zsh uses
[[ -x "/opt/homebrew/bin/brew" ]] && eval "$(/opt/homebrew/bin/brew shellenv)"
source "${ZSH}/custom/mmc/env/go.zsh"
source "${ZSH}/custom/mmc/env/nix.zsh"
source "${ZSH}/custom/mmc/env/path.zsh"
